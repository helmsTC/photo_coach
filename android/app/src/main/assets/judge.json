 "advice": {
  "lighting": {
   "title": "The light itself is weaker",
   "fix": "reshoot",
   "shoot": [
    "Light is the one thing you cannot add later. Come back in the hour after sunrise or before sunset when it is low, warm and directional - or right after weather clears.",
    "Put the light to the side of or behind the subject for shape and depth; front-lit and overhead midday light flattens everything."
   ],
   "edit": [
    "Dodging and burning can emphasise existing light, but cannot change its direction."
   ]
  },
  "exposure": {
   "title": "Exposure is off",
   "fix": "edit",
   "shoot": [
    "Check the histogram after the shot: nothing piled against either edge. Use exposure compensation (+/- 0.7 EV) when the scene is mostly bright or mostly dark.",
    "Turn on highlight warnings; if the scene has more range than the sensor, bracket or expose for the highlights and shoot RAW."
   ],
   "edit": [
    "Adjust Exposure until the mid-tones sit right, then recover Highlights and lift Shadows. Clipped white cannot be brought back."
   ]
  },
  "contrast": {
   "title": "Weaker tonal separation",
   "fix": "edit",
   "shoot": [
    "Flat tone usually comes from flat light or haze: shoot with the sun to the side, avoid midday haze, use a lens hood and a clean lens."
   ],
   "edit": [
    "Set a true black and white point (Blacks down, Whites up), add a gentle S-curve and a little Dehaze/Clarity."
   ]
  },
  "color_harmony": {
   "title": "Less cohesive colour palette",
   "fix": "both",
   "shoot": [
    "Simplify the palette: frame so two or three related or complementary colours dominate, and exclude stray bright objects."
   ],
   "edit": [
    "Use HSL / colour grading to pull distracting hues toward the main palette."
   ]
  },
  "vivid_color": {
   "title": "Muted colour",
   "fix": "edit",
   "shoot": [
    "Colour is richest in low-angle light and just after rain; a polariser deepens skies, foliage and water by removing glare."
   ],
   "edit": [
    "Add Vibrance rather than Saturation so already-strong colours don't go neon."
   ]
  },
  "color_accuracy": {
   "title": "Colour looks off",
   "fix": "edit",
   "shoot": [
    "Set white balance for the light (Daylight / Cloudy / Shade) instead of Auto, or shoot RAW and set it afterwards.",
    "Turn off 'Vivid' picture styles."
   ],
   "edit": [
    "Click the white-balance eyedropper on something that should be grey; pull Saturation back until skin, sky and foliage look believable."
   ]
  },
  "sharpness": {
   "title": "Softer detail",
   "fix": "reshoot",
   "shoot": [
    "Focus deliberately: tap on the subject (for landscapes, about a third of the way into the scene) and check at 100% before leaving.",
    "Hand-held, keep the shutter at 1/(2x focal length) or faster; brace the camera and keep stabilisation on."
   ],
   "edit": [
    "Capture sharpening helps slightly-soft files, but cannot rescue missed focus or shake."
   ]
  },
  "noise": {
   "title": "Visible noise",
   "fix": "both",
   "shoot": [
    "Use the lowest ISO the light allows: add light, open the aperture, or use a tripod with a longer shutter.",
    "Expose generously - brightening a dark file afterwards multiplies noise."
   ],
   "edit": [
    "Apply luminance + colour noise reduction, then sharpen lightly."
   ]
  },
  "depth_of_field": {
   "title": "Less subject separation (depth of field)",
   "fix": "reshoot",
   "shoot": [
    "To blur the background: widest aperture, longer lens, get closer to the subject, and put distance between subject and background.",
    "On a phone, use the 2x/3x lens or Portrait mode and move in close."
   ],
   "edit": [
    "Background blur added in software rarely looks natural around hair and fine edges - get it in camera."
   ]
  },
  "subject_emphasis": {
   "title": "The subject doesn't stand out",
   "fix": "both",
   "shoot": [
    "Decide what the one subject is, then remove competition: get closer, simplify the background, or change angle so the subject stands against something plain.",
    "Run your eye around the border before pressing the shutter; step sideways or zoom to drop anything bright or cut-off at the edges."
   ],
   "edit": [
    "A crop can tighten the frame and move the subject onto a stronger position."
   ]
  },
  "framing": {
   "title": "Looser framing",
   "fix": "both",
   "shoot": [
    "Leave breathing room around the subject and avoid cutting things off at the frame edge; fill the frame with what matters."
   ],
   "edit": [
    "Try a few crops before reshooting."
   ]
  },
  "level": {
   "title": "Frame looks tilted",
   "fix": "edit",
   "shoot": [
    "Switch on the grid or electronic level and line the horizon up with it."
   ],
   "edit": [
    "Straighten with the crop tool; fix converging verticals with perspective correction."
   ]
  },
  "content": {
   "title": "Less engaging subject matter",
   "fix": "reshoot",
   "shoot": [
    "Give the viewer something to land on: a person for scale, a boat, wildlife, a striking foreground, or a moment (weather, reflection, light beam).",
    "Ask what the photo is about, and exclude everything that isn't that."
   ],
   "edit": []
  }
 }
